{
  "extends": "@omnipost/config/tsconfig/base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": "./",
    "paths": {
      "@omnipost/types": ["../types/dist"],
      "@omnipost/types/*": ["../types/dist/*"],
      "@omnipost/validation": ["../validation/dist"],
      "@omnipost/validation/*": ["../validation/dist/*"]
    }
  },
  "include": ["src/**/*"]
}

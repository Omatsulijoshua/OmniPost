# ==========================================
# OMNIPOST ENVIRONMENT CONFIGURATION TEMPLATE
# ==========================================

# Server & Application Mode
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# Database (PostgreSQL)
DATABASE_URL=postgresql://omnipost:omnipost_secure_password@localhost:5432/omnipost_db?schema=public

# Queue & Caching (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Authentication & Security
JWT_SECRET=super_secret_jwt_encryption_key_change_in_production
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_change_in_production
CREDENTIAL_ENCRYPTION_KEY=32_byte_hex_string_for_token_encryption_at_rest

# AI Providers
OPENAI_API_KEY=your_openai_api_key
GEMINI_API_KEY=your_gemini_api_key

# Object Storage (S3 / Cloudflare R2 Abstraction)
STORAGE_PROVIDER=s3
STORAGE_ENDPOINT=https://s3.amazonaws.com
STORAGE_BUCKET=omnipost-media
STORAGE_ACCESS_KEY=your_storage_access_key
STORAGE_SECRET_KEY=your_storage_secret_key
STORAGE_REGION=us-east-1

# Social Media API Credentials (OAuth 2.0)
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

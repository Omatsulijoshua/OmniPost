{
  "extends": "@omnipost/config/tsconfig/nestjs.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": "./",
    "paths": {
      "@omnipost/types": ["../../packages/types/dist/index.d.ts"],
      "@omnipost/types/*": ["../../packages/types/dist/*"],
      "@omnipost/validation": ["../../packages/validation/dist/index.d.ts"],
      "@omnipost/validation/*": ["../../packages/validation/dist/*"],
      "@omnipost/ai-core": ["../../packages/ai-core/dist/index.d.ts"],
      "@omnipost/ai-core/*": ["../../packages/ai-core/dist/*"],
      "@omnipost/analytics-core": ["../../packages/analytics-core/dist/index.d.ts"],
      "@omnipost/analytics-core/*": ["../../packages/analytics-core/dist/*"],
      "@omnipost/billing-core": ["../../packages/billing-core/dist/index.d.ts"],
      "@omnipost/billing-core/*": ["../../packages/billing-core/dist/*"],
      "@omnipost/brand-core": ["../../packages/brand-core/dist/index.d.ts"],
      "@omnipost/brand-core/*": ["../../packages/brand-core/dist/*"],
      "@omnipost/media-core": ["../../packages/media-core/dist/index.d.ts"],
      "@omnipost/media-core/*": ["../../packages/media-core/dist/*"],
      "@omnipost/platform-core": ["../../packages/platform-core/dist/index.d.ts"],
      "@omnipost/platform-core/*": ["../../packages/platform-core/dist/*"],
      "@omnipost/publishing-core": ["../../packages/publishing-core/dist/index.d.ts"],
      "@omnipost/publishing-core/*": ["../../packages/publishing-core/dist/*"],
      "@omnipost/shared": ["../../packages/shared/dist/index.d.ts"],
      "@omnipost/shared/*": ["../../packages/shared/dist/*"]
    }
  },
  "include": ["src/**/*"]
}
